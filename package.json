{
  "name": "@pavegrid/mcp",
  "version": "0.1.1",
  "description": "Read-only PaveGrid tools for local MCP hosts",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pavegrid-mcp": "dist/cli.cjs"
  },
  "files": [
    "dist/cli.cjs",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pavegrid/mcp.git"
  },
  "homepage": "https://github.com/pavegrid/mcp#readme",
  "bugs": {
    "url": "https://github.com/pavegrid/mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "test": "tsx --test test/api.test.ts test/links.test.ts test/main.test.ts test/store.test.ts test/tools.test.ts test/stdio.test.ts",
    "test:store": "tsx --test test/native.real.ts",
    "build": "node scripts/build.mjs",
    "test:pack": "node scripts/test-pack.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "undici": "6.29.0",
    "zod": "4.6.7"
  }
}
